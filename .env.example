# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนค่าทุกตัว (.env ไม่ถูก commit)
#   cp .env.example .env
# ค่าด้านล่างเป็นตัวอย่างเท่านั้น ห้ามนำไปใช้จริง

# รหัสผ่านฐานข้อมูล: ใช้เฉพาะตัวอักษร ตัวเลข และ - _ . เพราะถูกแทรกใน POSTGRES_DSN (URL)
POSTGRES_PASSWORD=change-me-postgres

# รหัสผ่านผู้ดูแล Keycloak (ผู้ใช้ admin) สำหรับเข้า http://localhost:8180
KC_ADMIN_PASSWORD=change-me-admin

# client secret ของ client "bookingtable" ใน Keycloak
# ใช้ทั้งฝั่ง api และตอน import realm (ค่า ${KEYCLOAK_CLIENT_SECRET} ใน keycloak/import/pea-realm.json)
# สร้างค่าสุ่มได้ด้วย: openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
