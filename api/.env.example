# คัดลอกเป็น api/.env (ไม่ถูก commit) สำหรับคำสั่ง goose ที่รันบนเครื่อง host
#   cp api/.env.example api/.env
# รหัสผ่านใน GOOSE_DBSTRING ต้องตรงกับ POSTGRES_PASSWORD ใน .env ที่ราก
# พอร์ต 5532 คือพอร์ตของ postgres ที่ compose เปิดออกมาที่ host
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:change-me-postgres@localhost:5532/bookingtable?sslmode=disable
